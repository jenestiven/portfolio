---
import { getCollection } from 'astro:content';
import MapView from '../components/map/MapView.tsx';
import ContactWidget from '../components/ui/ContactWidget.tsx';
import Layout from '../layouts/Layout.astro';
import type { Scene } from '../types';

// El orden del recorrido lo decide TOUR_ORDER en MapView.tsx, no el glob de
// la colección: aquí solo se entregan las escenas disponibles.
const entries = await getCollection('scenes');
const scenes: Scene[] = entries.map((entry) => entry.data);
---

<Layout>
	<!-- Mapa a pantalla completa: una sola instancia, sin scroll de página. -->
	<div class="fixed inset-0 z-0">
		<MapView scenes={scenes} client:load />
	</div>

	<!--
		Contacto fuera del contenedor del mapa: es independiente de la escena
		activa y del tour, y sobrevive a cualquier cambio dentro de MapView.
	-->
	<ContactWidget client:load />
</Layout>
