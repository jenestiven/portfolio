---
import { getCollection } from 'astro:content';
import MapView from '../components/map/MapView.tsx';
import ScrollScenes from '../components/scroll/ScrollScenes.tsx';
import Layout from '../layouts/Layout.astro';
import type { Scene } from '../types';

const entries = await getCollection('scenes');
const scenes: Scene[] = entries.map((entry) => entry.data);
---

<Layout>
	<!-- Mapa de fondo: una sola instancia, fija, por debajo del scroll -->
	<div class="fixed inset-0 z-0">
		<MapView scenes={scenes} client:load />
	</div>

	<!-- Secciones scrolleables encima del mapa -->
	<ScrollScenes scenes={scenes} />
</Layout>
